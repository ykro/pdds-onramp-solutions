# Local PostgreSQL (Steps 3 and 4)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tiendita
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tiendita

# Auth (Step 4 uses local test JWKS; Step 5 uses Neon Auth)
NEON_AUTH_JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=https://tiendita.local
JWT_AUDIENCE=tiendita-api

# CORS for local Vite dev server
ALLOWED_ORIGINS=http://localhost:5173
